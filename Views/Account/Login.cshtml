@model WebsiteTour.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    ViewData["HideNavFooter"] = true;
}

<div class="min-h-screen flex items-center justify-center relative overflow-hidden font-sans bg-slate-900">
  
  <div class="absolute inset-0 z-0">
    <img 
      src="https://lh3.googleusercontent.com/aida-public/AB6AXuD0XcUYC6MCPhiKsd2nacmTbDfAMsZg2srpla_Sok9lRvIqE6cDwaKMI6Fxn90wF1c8yTr6Le7sE-eyRWFlxCSIO3mmvq19He_i4fOp3dXTu-uBy1fYJS6hApA-5G1D6r8P8C3DHas9YU1eXV9JPuqkWmiLtaKnln3SK5o5rPE_Upul61Y3kVu_RF-BE3owx4sV_WiC5IeX1zxSLLWYjCA8jB1nOMZjl2867V6lhRnuNxKjvQfZfqcibudFQG4-U78wYcNXz1kifw" 
      alt="Background" 
      class="w-full h-full object-cover opacity-60"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-primary-dark/60 to-transparent"></div>
  </div>

  <div class="relative z-10 flex flex-col md:flex-row bg-white/10 backdrop-blur-md rounded-3xl overflow-hidden shadow-2xl max-w-5xl w-full mx-4">
    <div class="hidden md:flex flex-1 flex-col justify-end p-12 text-white">
      <div class="mb-8">
        <span class="text-sm font-bold uppercase tracking-widest text-primary-light mb-4 block">Khám phá Việt Nam</span>
        <div class="flex items-center gap-3 mb-4">
          <i data-lucide="compass" class="w-10 h-10 text-white"></i>
          <h1 class="text-5xl font-bold tracking-tighter">VietExplore</h1>
        </div>
        <p class="text-lg text-white/90 max-w-sm">Hành trình trải nghiệm vẻ đẹp tiềm ẩn của dải đất hình chữ S bắt đầu từ đây.</p>
      </div>
    </div>

    <div class="bg-white p-10 md:p-16 flex flex-col justify-center flex-1 w-full max-w-lg mx-auto md:max-w-none">
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-6 md:hidden">
           <i data-lucide="compass" class="text-primary w-8 h-8"></i>
           <span class="text-2xl font-black text-primary">VietExplore</span>
        </div>
        <h2 class="text-3xl font-bold text-primary-dark mb-2">Chào mừng trở lại</h2>
        <p class="text-slate-500">Vui lòng đăng nhập để tiếp tục hành trình của bạn.</p>
      </div>

      <form class="space-y-6" asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm font-bold"></div>
        <div class="space-y-2">
          <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block ml-1" asp-for="EmailOrUsername">Email / Username</label>
          <div class="relative">
            <i data-lucide="user" class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 w-5 h-5"></i>
            <input 
              asp-for="EmailOrUsername"
              class="w-full pl-12 pr-4 py-4 rounded-xl bg-slate-50 border border-slate-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" 
              placeholder="name@example.com" 
            />
          </div>
          <span asp-validation-for="EmailOrUsername" class="text-red-500 text-xs font-bold"></span>
        </div>

        <div class="space-y-2">
          <div class="flex justify-between items-center px-1">
            <label class="text-xs font-bold text-slate-500 uppercase tracking-widest" asp-for="Password">Mật khẩu</label>
            <span class="text-xs font-bold text-primary hover:underline cursor-pointer">Quên mật khẩu?</span>
          </div>
          <div class="relative">
            <i data-lucide="lock" class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 w-5 h-5"></i>
            <input 
              asp-for="Password"
              class="w-full pl-12 pr-12 py-4 rounded-xl bg-slate-50 border border-slate-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" 
              placeholder="••••••••" 
            />
            <button type="button" class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-primary transition-colors">
              <i data-lucide="eye" class="w-5 h-5"></i>
            </button>
          </div>
          <span asp-validation-for="Password" class="text-red-500 text-xs font-bold"></span>
        </div>

        <button 
          type="submit"
          class="w-full py-4 bg-primary-dark text-white rounded-xl font-bold shadow-lg hover:shadow-primary/30 transition-all hover:-translate-y-0.5 active:scale-95"
        >
          Đăng nhập
        </button>
      </form>

      <div class="relative my-10 text-center">
        <div class="absolute inset-0 flex items-center">
           <div class="w-full border-t border-slate-100"></div>
        </div>
        <span class="relative bg-white px-4 text-xs font-bold text-slate-400 uppercase tracking-widest">Hoặc đăng nhập bằng</span>
      </div>

      <div class="grid grid-cols-3 gap-4 mb-10">
        <button class="flex items-center justify-center py-3 border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors">
          <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuCAy7iznNneU6jjecqOg0IxKEuOsXmlxrazEzX1vLu52ypf4_cdgrbEzwaVGCsxBNdbAT3Wh0G1BupTOscx4Ds04TSp7oPeu8Y1DShRcdd4nlkN_nrdfkkeMiPnn9lToge1HwiCf78F_qw5mIEeo6QHlpEeC7EtoHSV6INJ9vKsFiiudss4i06wLhS-NkP3VSV0wggTlIdC3huKMuXJEnY1e9lvIxtPbMV2UPcSumr9Gc5cmi_X-UXVKqGQLq8irgeguUMnvKPi-g" class="w-6 h-6" alt="google" />
        </button>
        <button class="flex items-center justify-center py-3 border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors text-[#1877F2]">
          <span class="text-2xl font-black">f</span>
        </button>
        <button class="flex items-center justify-center py-3 border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors text-black">
           <i data-lucide="apple" class="fill-black w-6 h-6"></i>
        </button>
      </div>

      <p class="text-center text-slate-600">
        Chưa có tài khoản? <a href="/Home/Register" class="text-primary font-bold cursor-pointer hover:underline">Đăng ký ngay</a>
      </p>
    </div>
  </div>
</div>