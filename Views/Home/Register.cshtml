@model WebsiteTour.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    ViewData["HideNavFooter"] = true;
}

<div class="min-h-screen flex flex-col md:flex-row font-sans">
  
  <section class="hidden md:flex md:w-3/5 relative overflow-hidden bg-primary-dark">
    <img 
      src="https://lh3.googleusercontent.com/aida-public/AB6AXuAldUcBYDMtW5rg3NuLC-eDTEk9AIBe4TRAkE2RjSCjCLuvVnnZx4kRR1emcFaURqIn4hNGP2GLSNOeCXoPX3Iei5Ehf3x7Db_tVWFsxFaBW_nqaJsqDeEjBCoJWjmDfD5Lc4FBcNC77IvPbpqN4jC0nyokQ0xjsriOg7mUSnb3NJBET5epOha-I2zIJTrtkYncnqcyFiQkjXzeKQ9N39re_aDXdVqJKUuh9thV1MCwPJ66SJZfO40Vb6lr58LOMG4IPLZ9eKI3Sg" 
      alt="Vietnam Landscape" 
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-primary-dark/80 via-transparent to-transparent"></div>
    <div class="relative z-10 p-20 flex flex-col justify-end h-full max-w-2xl">
      <div class="mb-8">
        <span class="text-white font-black text-2xl tracking-tight">VietExplore</span>
      </div>
      <h1>
        Khám phá vẻ đẹp tiềm ẩn của Việt Nam.
      </h1>
      <p class="text-white/90 text-lg mb-10 leading-relaxed">
        Hành trình của bạn bắt đầu từ đây. Tham gia cộng đồng VietExplore để nhận những ưu đãi đặc quyền và cảm hứng du lịch mỗi ngày.
      </p>
      <div class="flex gap-6">
        <div class="flex items-center gap-4 bg-white/10 backdrop-blur-md p-4 rounded-xl">
          <i data-lucide="star" class="text-white fill-white w-6 h-6"></i>
          <div>
            <p class="text-white font-bold">500k+</p>
            <p class="text-white/70 text-xs uppercase tracking-tighter">Thành viên</p>
          </div>
        </div>
        <div class="flex items-center gap-4 bg-white/10 backdrop-blur-md p-4 rounded-xl">
          <i data-lucide="map-pin" class="text-white fill-white w-6 h-6"></i>
          <div>
            <p class="text-white font-bold">2000+</p>
            <p class="text-white/70 text-xs uppercase tracking-tighter">Điểm đến</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="w-full md:w-2/5 flex flex-col justify-center items-center p-8 md:p-16 bg-white relative overflow-y-auto">
    <div class="w-full max-w-md z-10">
      <div class="mb-10">
        <div class="mb-4">
          <span class="text-2xl font-black text-primary-dark">VietExplore</span>
        </div>
        <h2 class="text-3xl font-bold text-primary-dark mb-2">Bắt đầu hành trình của bạn</h2>
        <p class="text-slate-500">Tạo tài khoản để mở khóa những trải nghiệm tuyệt vời nhất tại Việt Nam.</p>
      </div>

      <form class="space-y-4" asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm font-bold"></div>
        <div class="space-y-1">
          <label class="block text-sm font-semibold text-slate-600 ml-1" asp-for="Username">Họ và tên / Username</label>
          <div class="relative">
            <i data-lucide="user" class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 w-5 h-5"></i>
            <input 
              asp-for="Username"
              class="w-full pl-11 pr-4 py-3 rounded-lg border border-slate-200 focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none" 
              placeholder="nguyenvana" 
            />
          </div>
          <span asp-validation-for="Username" class="text-red-500 text-xs font-bold"></span>
        </div>

        <div class="space-y-1">
          <label class="block text-sm font-semibold text-slate-600 ml-1" asp-for="Email">Email</label>
          <div class="relative">
            <i data-lucide="mail" class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 w-5 h-5"></i>
            <input 
              asp-for="Email"
              class="w-full pl-11 pr-4 py-3 rounded-lg border border-slate-200 focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none" 
              placeholder="email@vietae.com" 
            />
          </div>
          <span asp-validation-for="Email" class="text-red-500 text-xs font-bold"></span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1">
            <label class="block text-sm font-semibold text-slate-600 ml-1" asp-for="Password">Mật khẩu</label>
            <div class="relative">
              <i data-lucide="lock" class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 w-5 h-5"></i>
              <input 
                asp-for="Password"
                class="w-full pl-11 pr-4 py-3 rounded-lg border border-slate-200 focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none" 
                placeholder="••••••••" 
              />
            </div>
            <span asp-validation-for="Password" class="text-red-500 text-xs font-bold"></span>
          </div>
          <div class="space-y-1">
            <label class="block text-sm font-semibold text-slate-600 ml-1" asp-for="ConfirmPassword">Xác nhận</label>
            <div class="relative">
              <i data-lucide="rotate-ccw" class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 w-5 h-5"></i>
              <input 
                asp-for="ConfirmPassword"
                class="w-full pl-11 pr-4 py-3 rounded-lg border border-slate-200 focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none" 
                placeholder="••••••••" 
              />
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs font-bold"></span>
          </div>
        </div>

        <div class="flex items-start gap-3 py-2">
          <input type="checkbox" class="mt-1 w-5 h-5 rounded border-slate-300 text-primary focus:ring-primary" id="terms" required />
          <label for="terms" class="text-sm text-slate-500 leading-tight">
            Tôi đồng ý với các <span class="text-primary font-semibold cursor-pointer">điều khoản dịch vụ</span> và <span class="text-primary font-semibold cursor-pointer">chính sách bảo mật</span> của VietExplore.
          </label>
        </div>

        <button 
          type="submit"
          class="w-full py-4 bg-accent text-white font-bold rounded-lg shadow-lg hover:bg-accent-dark transition-all flex justify-center items-center gap-2"
        >
          Đăng ký ngay <i data-lucide="arrow-right" class="w-5 h-5"></i>
        </button>
      </form>

      <div class="mt-8">
        <div class="relative flex items-center justify-center mb-6">
          <div class="flex-grow border-t border-slate-200"></div>
          <span class="flex-shrink mx-4 text-xs font-bold uppercase tracking-widest text-slate-400">Hoặc đăng ký bằng</span>
          <div class="flex-grow border-t border-slate-200"></div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <button class="flex items-center justify-center gap-2 py-3 px-4 rounded-lg border border-slate-200 hover:bg-slate-50 transition-colors font-semibold text-sm">
            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBBoC736VSjCmvmLAjSNfCbCyDRw3DVyRLGfQnD91XBaeKjpYkROc9FJ5ZN7ugQzTZPG95NvT_pAPmOiiDayFhozlCgNKcnOLw9YF18uO0DBqj9kuxwLFhFb8RQ9gppLHQldsZTYN-1ct0zY264wwfvuHyI7DtFH4LxFMqtsJct3tiG3t0UKpAtNW_8XQK9UrVZZCj56duLotGrEG7f0AXCYwTKVyBH2etykbn1oOnij_euMErbZ3xIjRsl64n7u0SRuoLDOJBBeQ" class="w-5 h-5" alt="Google" />
            <span>Google</span>
          </button>
          <button class="flex items-center justify-center gap-2 py-3 px-4 rounded-lg bg-[#1877F2] text-white hover:opacity-90 transition-all font-semibold text-sm">
             <span class="font-bold">f</span>
            <span>Facebook</span>
          </button>
        </div>
      </div>

      <div class="mt-12 text-center text-slate-600">
        Bạn đã có tài khoản? <a href="/Home/Login" class="text-primary font-bold cursor-pointer hover:underline">Đăng nhập ngay</a>
      </div>
    </div>
  </section>
</div>