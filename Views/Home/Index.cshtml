      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/Tour/Tours" class="px-8 py-4 bg-accent text-white font-bold rounded-2xl hover:bg-white hover:text-accent transition-all shadow-[0_0_40px_rgba(255,165,0,0.4)] hover:shadow-[0_0_60px_rgba(255,165,0,0.6)] text-lg no-underline flex items-center gap-2">
          Khám Phá Ngay <i data-lucide="compass" class="w-5 h-5"></i>
        </a>
        <a href="#why-choose-us" class="px-8 py-4 bg-white/10 text-white font-bold rounded-2xl border border-white/20 hover:bg-white/20 backdrop-blur-md transition-all text-lg no-underline flex items-center gap-2">
          Tìm Hiểu Thêm
        </a>
      </div>
    </div>
  </section>

 <!-- Personalized Recommendations (If user has data) -->
  @if (Model.RecommendedTours.Any())
  {
    <section class="py-24 bg-slate-50">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-sm font-black text-primary uppercase tracking-widest mb-3">Dành Riêng Cho Bạn</h2>
          <h3 class="text-3xl md:text-4xl font-bold text-slate-800">Gợi Ý Được Cá Nhân Hóa</h3>
          <p class="text-slate-500 mt-4">Hệ thống AI của chúng tôi phân tích sở thích của bạn để đưa ra những lịch trình hoàn hảo nhất.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          @foreach (var tour in Model.RecommendedTours.Take(3))
          {
            <a href="/Home/TourDetail/@tour.Id" class="group cursor-pointer flex flex-col h-full bg-white rounded-3xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-2xl transition-all duration-300 relative no-underline">
              <div class="relative h-64 overflow-hidden">
                <img src="@tour.Images.FirstOrDefault()?.ImageUrl" alt="@tour.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors"></div>
              </div>
              <div class="p-6 flex-1 flex flex-col">
                <h3 class="font-bold text-xl text-slate-800 mb-2 line-clamp-2 leading-snug group-hover:text-primary transition-colors">@tour.Title</h3>
                <p class="text-sm text-slate-500 mb-6">@tour.Duration • @tour.Destination?.Name</p>
                <div class="mt-auto flex items-center justify-between">
                  <div class="font-black text-2xl text-primary-dark">$@tour.Price</div>
                  <div class="px-4 py-2 bg-primary/10 text-primary font-bold rounded-xl group-hover:bg-primary group-hover:text-white transition-all">Xem Tour</div>
                </div>
              </div>
            </a>
          }
        </div>
      </div>
    </section>
  }

  <!-- Features / Why Choose Us -->
  <section id="why-choose-us" class="py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-sm font-black text-accent uppercase tracking-widest mb-3">Lý Do Chọn Chúng Tôi</h2>
        <h3 class="text-3xl md:text-4xl font-bold text-slate-800">Trải Nghiệm Dịch Vụ Đẳng Cấp Xứng Tầm</h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <div class="bg-white p-8 rounded-3xl shadow-sm hover:shadow-xl transition-all border border-slate-100 group">
          <div class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center text-primary mb-6 group-hover:scale-110 group-hover:bg-primary group-hover:text-white transition-all">
            <i data-lucide="map" class="w-8 h-8"></i>
          </div>
          <h4 class="text-xl font-bold text-slate-800 mb-3">Hành Trình Độc Bản</h4>
          <p class="text-slate-500 leading-relaxed">Thiết kế tour cá nhân hóa, độc quyền không trùng lặp, đưa bạn đến những vùng đất hoang sơ và kỳ vĩ nhất Việt Nam.</p>
        </div>
        <div class="bg-white p-8 rounded-3xl shadow-sm hover:shadow-xl transition-all border border-slate-100 group">
          <div class="w-16 h-16 rounded-2xl bg-accent/10 flex items-center justify-center text-accent mb-6 group-hover:scale-110 group-hover:bg-accent group-hover:text-white transition-all">
            <i data-lucide="shield-check" class="w-8 h-8"></i>
          </div>
          <h4 class="text-xl font-bold text-slate-800 mb-3">Bảo Đảm An Toàn</h4>
          <p class="text-slate-500 leading-relaxed">Hệ thống bảo hiểm du lịch toàn diện 24/7. Hướng dẫn viên chuyên nghiệp được đào tạo chứng chỉ quốc tế.</p>
        </div>
        <div class="bg-white p-8 rounded-3xl shadow-sm hover:shadow-xl transition-all border border-slate-100 group">
          <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 flex items-center justify-center text-emerald-500 mb-6 group-hover:scale-110 group-hover:bg-emerald-500 group-hover:text-white transition-all">
            <i data-lucide="badge-dollar-sign" class="w-8 h-8"></i>
          </div>
          <h4 class="text-xl font-bold text-slate-800 mb-3">Cam Kết Giá Tốt</h4>
          <p class="text-slate-500 leading-relaxed">Không phát sinh phụ phí. Chúng tôi tự hào mang đến chất lượng dịch vụ 5 sao với mức giá ưu đãi nhất thị trường.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Popular Tours -->
  <section class="py-24 bg-white relative">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
        <div>
          <h2 class="text-sm font-black text-accent uppercase tracking-widest mb-3">Hot Nhất Tuần Này</h2>
          <h3 class="text-3xl md:text-4xl font-bold text-slate-800">Tour Được Yêu Thích Nhất</h3>
        </div>
        <a href="/Tour/Tours" class="flex items-center gap-2 text-primary font-bold hover:text-primary-dark transition-colors px-6 py-3 rounded-xl bg-primary/5 hover:bg-primary/10 no-underline">
          Khám phá thêm <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        @foreach (var tour in Model.PopularTours)
        {
          <a href="/Tour/TourDetail/@tour.Id" class="group cursor-pointer flex flex-col h-full bg-white rounded-3xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 relative no-underline">
            <button class="absolute top-4 right-4 z-20 w-10 h-10 bg-white/20 backdrop-blur-md rounded-full flex items-center justify-center hover:bg-white/40 transition-colors">
              <i data-lucide="heart" class="w-5 h-5 text-white"></i>
            </button>
            <div class="relative h-64 overflow-hidden">
              <img src="@tour.Images.FirstOrDefault()?.ImageUrl" alt="@tour.Title" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
              <div class="absolute bottom-4 left-4 right-4 flex justify-between items-end">
                <div class="flex items-center gap-1.5 text-white bg-black/40 backdrop-blur-md px-3 py-1.5 rounded-lg border border-white/10">
                  @if (tour.TotalReviews > 0)
                  {
                    <i data-lucide="star" class="w-4 h-4 fill-accent text-accent"></i>
                    <span class="text-sm font-bold">@tour.Rating.ToString("0.0")</span>
                  }
                  else
                  {
                    <span class="text-xs font-bold tracking-wider">MỚI</span>
                  }
                </div>
                <span class="bg-white text-primary text-xs font-black px-3 py-1.5 rounded-xl shadow-lg">@tour.Duration</span>
              </div>
            </div>
            <div class="p-6 flex-1 flex flex-col">
              <div class="flex items-center gap-2 text-slate-500 text-xs font-bold mb-3 uppercase tracking-wider">
                <i data-lucide="map-pin" class="w-4 h-4 text-primary"></i>@tour.Destination?.Name
              </div>
              <h3 class="font-bold text-xl text-slate-800 mb-4 line-clamp-2 leading-snug group-hover:text-primary transition-colors">@tour.Title</h3>
              <div class="mt-auto pt-6 border-t border-slate-100 flex items-center justify-between">
                <div>
                  <div class="text-xs text-slate-400 font-medium mb-1">Trọn gói từ</div>
                  <div class="font-black text-2xl text-accent">$@tour.Price</div>
                </div>
                <div class="bg-primary/5 text-primary w-12 h-12 rounded-full flex items-center justify-center group-hover:bg-primary group-hover:text-white group-hover:scale-110 transition-all">
                  <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </div>
              </div>
            </div>
          </a>
        }
      </div>
    </div>
  </section>

  <!-- Region / Destination Tabs -->
