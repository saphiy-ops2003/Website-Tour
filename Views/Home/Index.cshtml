        <h3 class="text-3xl md:text-5xl font-bold text-slate-800 mb-6">Điểm Đến Trong Mơ Của Bạn</h3>
        <p class="text-slate-500 text-lg">Hàng trăm tọa độ du lịch hấp dẫn trải dài từ Bắc chí Nam đang chờ bạn bước tới.</p>
      </div>

      <!-- Tab Buttons -->
      <div class="flex flex-wrap justify-center gap-3 mb-12">
        @for (int i = 0; i < Model.DestinationRegions.Count; i++)
        {
          var region = Model.DestinationRegions[i];
          <button onclick="switchTab('region-@region.RegionId')" class="region-tab-btn px-6 py-3 rounded-full text-sm font-bold transition-all border border-slate-200 hover:border-primary @(i == 0 ? "bg-primary text-white shadow-lg border-primary" : "text-slate-500 hover:bg-white bg-white shadow-sm")" data-target="region-@region.RegionId">
            @region.RegionName
          </button>
        }
      </div>

      <!-- Tab Contents -->
      <div>
        @for (int i = 0; i < Model.DestinationRegions.Count; i++)
        {
          var region = Model.DestinationRegions[i];
          var destinations = region.Destinations.Take(7).ToList();
          <div id="region-@region.RegionId" class="region-tab-content grid grid-cols-2 md:grid-cols-4 auto-rows-[200px] gap-4 @(i == 0 ? "" : "hidden") animate-fade-in">
            @for (int j = 0; j < destinations.Count; j++)
            {
              var destination = destinations[j];
              string spanClass = "col-span-1 row-span-1";
              if (j == 0) spanClass = "col-span-2 row-span-2 md:col-span-2 md:row-span-2";
              else if (j == 1 || j == 2) spanClass = "col-span-1 row-span-1";
              else if (j == 3) spanClass = "col-span-2 row-span-1 md:col-span-2 md:row-span-1";
              else spanClass = "col-span-1 row-span-1";

              var imgUrl = !string.IsNullOrEmpty(destination.ImageUrl) 
                           ? destination.ImageUrl 
                           : "https://images.unsplash.com/photo-1599839619722-39751411ea63";

              <a href="/Tour/Tours?destinationId=@destination.Id" class="group relative rounded-2xl overflow-hidden cursor-pointer block @spanClass">
                <img src="@imgUrl" alt="@destination.Name" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-slate-900/20 to-transparent group-hover:bg-primary/40 transition-colors duration-500"></div>
                
                <div class="absolute inset-0 flex flex-col justify-end p-6">
                  <h4 class="text-white font-bold text-xl leading-tight group-hover:-translate-y-4 transition-transform duration-500">@destination.Name</h4>
                  <p class="text-white/80 text-sm mt-1 opacity-100 group-hover:opacity-0 transition-opacity duration-300">@destination.TourDestinations.Count tours</p>
                  
                  <div class="absolute bottom-6 left-6 opacity-0 translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500 flex items-center gap-2 text-white font-bold">
                    Khám Phá <i data-lucide="arrow-right" class="w-4 h-4"></i>
                  </div>
                </div>
              </a>
            }
          </div>
        }
      </div>
    </div>
  </section>
