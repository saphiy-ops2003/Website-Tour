@model WebsiteTour.Models.Entities.Tour
@{
    ViewData["Title"] = "Checkout";
}

<div class="bg-slate-50 min-h-screen py-10 font-sans">
    <div class="max-w-4xl mx-auto px-6">
        <h1 class="text-3xl font-black text-primary-dark mb-8">Thanh toán & Đặt chỗ</h1>
        
        <div class="flex flex-col md:flex-row gap-8">
            <div class="flex-1 space-y-6">
                <!-- User Information -->
                <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm">
                    <h2 class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-2">
                        <i data-lucide="user" class="w-5 h-5 text-primary"></i> Thông tin liên hệ
                    </h2>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block mb-2">Họ Tên</label>
                            <input type="text" value="@User.Identity.Name" readonly class="w-full bg-slate-100 p-3 rounded-xl border border-transparent font-medium" />
                        </div>
                        <div>
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block mb-2">Email</label>
                            <input type="text" value="@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value" readonly class="w-full bg-slate-100 p-3 rounded-xl border border-transparent font-medium" />
                        </div>
                        <div class="col-span-2">
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block mb-2">Số điện thoại</label>
                            <input type="text" class="w-full bg-white p-3 rounded-xl border border-slate-200 focus:border-primary outline-none transition-all font-medium" placeholder="Nhập số điện thoại của bạn" />
                        </div>
                    </div>
                </div>

                <!-- Payment Details -->
                <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm">
                    <h2 class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-2">
                        <i data-lucide="credit-card" class="w-5 h-5 text-primary"></i> Phương thức thanh toán
                    </h2>
                    <div class="space-y-4">
                        <label class="flex items-center gap-4 p-4 border border-primary bg-primary/5 rounded-2xl cursor-pointer">
                            <input type="radio" name="payment" checked class="text-primary w-5 h-5 focus:ring-primary" />
                            <div class="flex-1">
                                <p class="font-bold text-slate-800">Thanh toán bằng thẻ (Stripe/Visa)</p>
                                <p class="text-sm text-slate-500">Thanh toán an toàn qua cổng Stripe</p>
                            </div>
                        </label>
                        <label class="flex items-center gap-4 p-4 border border-slate-200 rounded-2xl cursor-pointer">
                            <input type="radio" name="payment" class="text-primary w-5 h-5 focus:ring-primary" />
                            <div class="flex-1">
                                <p class="font-bold text-slate-800">Thanh toán khi tham gia</p>
                                <p class="text-sm text-slate-500">Thanh toán trực tiếp bằng tiền mặt hoặc chuyển khoản</p>
                            </div>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Booking Summary -->
            <div class="w-full md:w-[350px]">
                <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-xl sticky top-28">
                    <h3 class="text-lg font-bold text-slate-800 mb-4">Tóm tắt đơn hàng</h3>
                    
                    <div class="flex gap-4 mb-6 pb-6 border-b border-slate-100">
                        <img src="@Model.Images.FirstOrDefault()?.ImageUrl" class="w-20 h-20 object-cover rounded-xl" />
                        <div>
                            <h4 class="font-bold text-sm text-slate-800 line-clamp-2">@Model.Title</h4>
                            <p class="text-xs text-slate-500 mt-1">@Model.Duration</p>
                        </div>
                    </div>

                    <form action="/Home/Checkout" method="post">
                        <input type="hidden" name="tourId" value="@Model.Id" />
                        
                        @{
                            int adults = ViewBag.Adults ?? 2;
                            int children = ViewBag.Children ?? 0;
                            string promoCode = ViewBag.PromoCode ?? "";
                            decimal discount = ViewBag.Discount ?? 0m;
                            
                            decimal adultPrice = Model.Price;
                            decimal childPrice = Model.Price * 0.7m;
                            decimal subTotal = (adultPrice * adults) + (childPrice * children);
                            decimal total = subTotal + 10 - discount;
                        }
                        
                        <input type="hidden" name="adults" value="@adults" />
                        <input type="hidden" name="children" value="@children" />
                        <input type="hidden" name="promoCode" value="@promoCode" />

                        <div class="space-y-4 mb-6">
                            <div>
                                <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block mb-1">Khách tham gia</label>
                                <div class="w-full bg-slate-50 p-3 rounded-xl border border-slate-200 font-bold text-slate-800 flex items-center gap-2">
                                    <i data-lucide="users" class="w-4 h-4 text-slate-400"></i>
                                    @adults Người lớn @if(children > 0) { <text>, @children Trẻ em</text> }
                                </div>
                            </div>
                            <div>
                                <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block mb-1">Ngày khởi hành</label>
                                <div class="w-full bg-slate-50 p-3 rounded-xl border border-slate-200 font-bold text-slate-800 flex items-center gap-2">
                                    <i data-lucide="calendar" class="w-4 h-4 text-slate-400"></i>
                                    @{
                                        var schedule = ViewBag.Schedule as WebsiteTour.Models.Entities.TourSchedule;
                                    }
                                    @schedule?.StartDate.ToString("dd/MM/yyyy") (Còn @schedule?.AvailableSeats chỗ)
                                    <input type="hidden" name="scheduleId" value="@schedule?.Id" />
                                </div>
                            </div>
                        </div>

                        <div class="space-y-3 pb-6 border-b border-slate-100">
                            <div class="flex justify-between text-slate-600 text-sm items-center">
                                <span>Người lớn x @adults</span>
                                <span class="font-bold text-slate-800">$@(adultPrice * adults)</span>
                            </div>
                            @if(children > 0)
                            {
                                <div class="flex justify-between text-slate-600 text-sm items-center">
                                    <span>Trẻ em x @children</span>
                                    <span class="font-bold text-slate-800">$@(childPrice * children)</span>
                                </div>
                            }
                            <div class="flex justify-between text-slate-600 text-sm items-center">
                                <span>Phí dịch vụ</span>
                                <span class="font-bold text-slate-800">$10</span>
                            </div>
                            
                            @if(discount > 0)
                            {
                                <div class="mt-4 p-4 bg-green-50 border border-green-100 rounded-2xl relative overflow-hidden">
                                    <div class="absolute -right-4 -top-4 w-16 h-16 bg-green-500/10 rounded-full"></div>
                                    <div class="absolute -left-4 -bottom-4 w-12 h-12 bg-green-500/10 rounded-full"></div>
                                    
                                    <div class="flex justify-between items-center relative z-10">
                                        <div class="flex items-center gap-2">
                                            <div class="w-8 h-8 bg-green-500 text-white rounded-full flex items-center justify-center">
                                                <i data-lucide="ticket" class="w-4 h-4"></i>
                                            </div>
                                            <div>
                                                <span class="block text-xs font-bold text-green-700 uppercase tracking-widest">Mã áp dụng</span>
                                                <span class="block text-sm font-black text-green-800">@promoCode</span>
                                            </div>
                                        </div>
                                        <span class="text-lg font-black text-green-600">-$@discount</span>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="flex justify-between items-center py-6">
                            <span class="font-bold text-slate-800 uppercase tracking-widest text-xs">Tổng thanh toán</span>
                            <span class="text-4xl font-black text-primary-dark tracking-tight">$@Math.Max(0, total)</span>
                        </div>

                        <button type="submit" class="w-full py-4 bg-accent text-white font-bold rounded-xl shadow-lg hover:bg-accent-dark transition-all active:scale-95 flex justify-center items-center gap-2 mt-4">
                            Xác nhận đặt Tour <i data-lucide="check-circle" class="w-5 h-5"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>