@model IEnumerable<WebsiteTour.Models.Entities.Tour>
@{
    ViewData["Title"] = "Tour Gợi Ý";
    var source = (ViewBag.RecommendationSource as string) ?? "fallback";
}

<div class="bg-slate-50 min-h-screen py-12">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
      <div>
        <h1 class="text-4xl font-bold text-primary-dark mb-2">Tour Gợi Ý Cho Bạn</h1>
        <p class="text-slate-500 font-medium">
          @if (source == "ai")
          {
            <span>Danh sách được cá nhân hóa bằng AI.</span>
          }
          else
          {
            <span>AI tạm thời không khả dụng, hiển thị tour phổ biến thay thế.</span>
          }
        </p>
      </div>
      <a href="/Tour/Tours" class="px-5 py-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-100 no-underline text-slate-700 font-semibold">
        Xem tất cả tour
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      @foreach (var tour in Model)
      {
        <a href="/Tour/TourDetail/@tour.Id" class="group cursor-pointer flex flex-col h-full bg-white rounded-3xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-2xl transition-all duration-300 relative no-underline">
          <div class="relative h-64 overflow-hidden">
            <img src="@tour.Images.FirstOrDefault()?.ImageUrl" alt="@tour.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center gap-2 text-slate-500 text-xs font-bold mb-3 uppercase tracking-wider">
              <i data-lucide="map-pin" class="w-4 h-4 text-primary"></i>
              @tour.Destination?.Name
            </div>
            <h3 class="font-bold text-xl text-slate-800 mb-4 line-clamp-2 leading-snug group-hover:text-primary transition-colors">
              @tour.Title
            </h3>
            <div class="mt-auto pt-6 border-t border-slate-100 flex items-center justify-between">
              <div>
                <div class="text-xs text-slate-400 font-medium mb-1">Giá từ</div>
                <div class="font-black text-2xl text-primary-dark">
                  $@tour.Price<span class="text-sm text-slate-400 font-medium tracking-normal">/khách</span>
                </div>
              </div>
              <div class="bg-primary-light/30 text-primary w-12 h-12 rounded-xl flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-all">
                <i data-lucide="arrow-right" class="w-5 h-5"></i>
              </div>
            </div>
          </div>
        </a>
      }
    </div>
  </div>
</div>
