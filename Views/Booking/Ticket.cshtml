@model WebsiteTour.Models.Entities.Booking
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vé Tour #BKG-@Model.Id.ToString("D5") - VietExplore</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;900&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        @@media print {
            body { background-color: white; }
            .no-print { display: none !important; }
            .print-shadow-none { box-shadow: none !important; }
            .print-border { border: 1px solid #e2e8f0 !important; }
            @@page { margin: 0; size: auto; }
        }
        .ticket-cutout {
            position: relative;
        }
        .ticket-cutout::before, .ticket-cutout::after {
            content: '';
            position: absolute;
            top: 50%;
            width: 30px;
            height: 30px;
            background-color: #f8fafc;
            border-radius: 50%;
            transform: translateY(-50%);
            z-index: 10;
        }
        .ticket-cutout::before { left: -15px; box-shadow: inset -1px 0 0 rgba(0,0,0,0.05); }
        .ticket-cutout::after { right: -15px; box-shadow: inset 1px 0 0 rgba(0,0,0,0.05); }
        @@media print {
            .ticket-cutout::before, .ticket-cutout::after { background-color: white; border: 1px solid #e2e8f0; }
            .ticket-cutout::before { border-right: none; border-top: none; border-bottom: none; }
            .ticket-cutout::after { border-left: none; border-top: none; border-bottom: none; }
        }
        .dashed-line {
            background-image: linear-gradient(to bottom, #cbd5e1 50%, transparent 50%);
            background-size: 2px 14px;
            background-repeat: repeat-y;
            background-position: center;
        }
    </style>
</head>
<body class="py-10 px-4 min-h-screen flex flex-col items-center justify-center">

    <div class="no-print flex justify-between items-center w-full max-w-4xl mb-6">
        <a href="/Booking/Bookings" class="text-slate-500 hover:text-slate-800 flex items-center gap-2 font-medium">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Trở về Lịch sử Đặt Tour
        </a>
        <button onclick="window.print()" class="bg-orange-500 hover:bg-orange-600 text-white px-6 py-2.5 rounded-lg font-bold flex items-center gap-2 shadow-lg transition-all active:scale-95">
            <i data-lucide="printer" class="w-4 h-4"></i> In Vé / Lưu PDF
        </button>
    </div>

    <!-- Ticket Container -->
    <div class="w-full max-w-4xl bg-white rounded-3xl shadow-[0_10px_40px_rgba(0,0,0,0.08)] print-shadow-none print-border flex flex-col md:flex-row overflow-hidden relative">
        
        <!-- Left Section: Main Info -->
        <div class="flex-1 p-8 md:p-10">
            <div class="flex justify-between items-start mb-10">
                <div>
                    <h2 class="text-3xl font-black text-slate-800 tracking-tight">VietExplore<span class="text-orange-500">.</span></h2>
                    <p class="text-sm text-slate-400 font-medium uppercase tracking-widest mt-1">E-Ticket / Thẻ lên tàu</p>
                </div>
                <div class="text-right">
                    <p class="text-xs text-slate-400 uppercase tracking-widest font-bold mb-1">Mã Vé</p>
                    <p class="text-2xl font-black text-slate-800 font-mono tracking-tight">#BKG-@Model.Id.ToString("D5")</p>
                </div>
            </div>

            <h1 class="text-2xl md:text-3xl font-bold text-slate-800 mb-2 leading-snug">@Model.Tour?.Title</h1>
            <p class="text-orange-500 font-semibold mb-8 flex items-center gap-2">
                <i data-lucide="map-pin" class="w-4 h-4"></i> @Model.Tour?.Destination?.Name
            </p>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-8">
                <div>
                    <p class="text-xs text-slate-400 uppercase tracking-widest font-bold mb-1">Khởi Hành</p>
                    <p class="text-sm font-bold text-slate-800">
                        @(Model.TourSchedule != null ? Model.TourSchedule.StartDate.ToString("dd/MM/yyyy") : "Đang cập nhật")
                    </p>
                    <p class="text-xs text-slate-500 mt-0.5">07:00 AM</p>
                </div>
                <div>
                    <p class="text-xs text-slate-400 uppercase tracking-widest font-bold mb-1">Thời Gian</p>
                    <p class="text-sm font-bold text-slate-800">@Model.Tour?.Duration</p>
                </div>
                <div>
                    <p class="text-xs text-slate-400 uppercase tracking-widest font-bold mb-1">Hành Khách</p>
                    <p class="text-sm font-bold text-slate-800">
                        @Model.AdultCount Người lớn
                        @if (Model.ChildCount > 0)
                        {
                            <br/><span class="text-xs text-slate-500">@Model.ChildCount Trẻ em</span>
                        }
                    </p>
                </div>
                <div>
                    <p class="text-xs text-slate-400 uppercase tracking-widest font-bold mb-1">Trạng Thái</p>
                    <p class="text-sm font-bold @(Model.Status == "Pending" ? "text-amber-500" : "text-green-500") uppercase tracking-wider">
                        @(Model.Status == "Pending" ? "Đã Đặt" : "Hoàn Thành")
                    </p>
                </div>
            </div>

            <div class="bg-slate-50 p-4 rounded-xl border border-slate-100 flex items-start gap-3">
                <i data-lucide="info" class="w-5 h-5 text-orange-500 flex-shrink-0 mt-0.5"></i>
                <p class="text-sm text-slate-600 leading-relaxed">
                    Vui lòng mang theo E-Ticket này (có thể lưu trên điện thoại) và giấy tờ tùy thân (CMND/CCCD/Passport) đến điểm tập trung trước giờ khởi hành ít nhất 30 phút.
                </p>
            </div>
        </div>

        <!-- Right Section: QR Code -->
        <div class="ticket-cutout w-full md:w-72 bg-slate-800 text-white p-8 flex flex-col items-center justify-center relative">
            <div class="absolute left-0 top-0 bottom-0 w-[2px] dashed-line hidden md:block"></div>
            
            <p class="text-center text-sm text-slate-300 font-medium mb-6">Quét mã QR tại điểm đón</p>
            
            <div class="bg-white p-3 rounded-xl mb-6 shadow-inner">
                <div id="qrcode"></div>
            </div>
            
            <div class="text-center">
                <p class="text-[10px] text-slate-400 uppercase tracking-widest mb-1">Tổng Thanh Toán</p>
                <p class="text-3xl font-black text-white">$@Model.TotalPrice</p>
            </div>
            
            @if (Model.DiscountAmount > 0)
            {
                <div class="mt-4 px-3 py-1 bg-green-500/20 text-green-400 text-xs font-bold rounded-full border border-green-500/30">
                    Đã giảm $@Model.DiscountAmount
                </div>
            }
        </div>
    </div>

    <script>
        lucide.createIcons();
        
        // Generate QR Code with booking details
        const bookingInfo = `VietExplore Ticket\nID: BKG-${String(@Model.Id).padStart(5, '0')}\nTour: @Html.Raw(Model.Tour?.Title)\nGuests: @(Model.AdultCount + Model.ChildCount)`;
        
        new QRCode(document.getElementById("qrcode"), {
            text: bookingInfo,
            width: 140,
            height: 140,
            colorDark : "#0f172a",
            colorLight : "#ffffff",
            correctLevel : QRCode.CorrectLevel.M
        });
    </script>
</body>
</html>
