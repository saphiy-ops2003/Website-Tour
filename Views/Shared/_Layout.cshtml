<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VietExplore</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <script src="https://unpkg.com/@@tailwindcss/browser@4"></script>
    <style type="text/tailwindcss">
        @@theme {
          --font-sans: "Be Vietnam Pro", ui-sans-serif, system-ui, sans-serif;
          
          --color-primary-dark: #003f87;
          --color-primary: #0056b3;
          --color-primary-light: #acc7ff;
          --color-accent: #FF7F32;
          --color-accent-dark: #e66a20;
          --color-surface: #f8f9fa;
        }

        @@layer utilities {
          .glass-panel {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.3);
          }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-primary-light selection:text-primary-dark font-sans bg-surface text-slate-900">
    @{
        var hideNavFooter = ViewData["HideNavFooter"] as bool? ?? false;
        var currentView = ViewContext.RouteData.Values["action"]?.ToString()?.ToLower() ?? "index";
    }

    @if (!hideNavFooter)
    {
        <partial name="_Navbar" model="currentView" />
    }

    <main class="flex-grow">
        @RenderBody()
    </main>

    @if (!hideNavFooter)
    {
        <partial name="_Footer" />
    }

    <div id="toast-container" class="fixed top-24 right-6 z-[100] flex flex-col gap-3"></div>

    <template id="toast-success-template">
      <div class="toast-element transform translate-x-full opacity-0 transition-all duration-300 bg-white border border-slate-100 shadow-2xl rounded-2xl p-4 flex items-start gap-4 w-80 pointer-events-auto">
        <div class="w-10 h-10 rounded-full bg-green-100 text-green-600 flex items-center justify-center flex-shrink-0">
          <i data-lucide="check" class="w-5 h-5"></i>
        </div>
        <div class="flex-1 pt-1">
          <h4 class="text-sm font-bold text-slate-800 mb-1">Thành công</h4>
          <p class="text-xs text-slate-500 font-medium toast-message leading-relaxed"></p>
        </div>
        <button class="text-slate-400 hover:text-slate-600 transition-colors pt-1 cursor-pointer" onclick="this.closest('.toast-element').remove()">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>
    </template>

    <template id="toast-error-template">
      <div class="toast-element transform translate-x-full opacity-0 transition-all duration-300 bg-white border border-slate-100 shadow-2xl rounded-2xl p-4 flex items-start gap-4 w-80 pointer-events-auto">
        <div class="w-10 h-10 rounded-full bg-red-100 text-red-600 flex items-center justify-center flex-shrink-0">
          <i data-lucide="alert-circle" class="w-5 h-5"></i>
        </div>
        <div class="flex-1 pt-1">
          <h4 class="text-sm font-bold text-slate-800 mb-1">Có lỗi xảy ra</h4>
          <p class="text-xs text-slate-500 font-medium toast-message leading-relaxed"></p>
        </div>
        <button class="text-slate-400 hover:text-slate-600 transition-colors pt-1 cursor-pointer" onclick="this.closest('.toast-element').remove()">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>
    </template>

    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
      lucide.createIcons();
      
      @{
          var successMsg = TempData["SuccessMessage"] ?? ViewBag.SuccessMessage;
          var errorMsg = TempData["ErrorMessage"] ?? ViewBag.ErrorMessage;
      }
      
      function showToast(type, message) {
        const container = document.getElementById('toast-container');
        if (!container) return;
        
        const templateId = type === 'success' ? 'toast-success-template' : 'toast-error-template';
        const template = document.getElementById(templateId);
        if (!template) return;
        
        const clone = template.content.cloneNode(true);
        const toastEl = clone.querySelector('.toast-element');
        toastEl.querySelector('.toast-message').textContent = message;
        
        container.appendChild(clone);
        lucide.createIcons();
        
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            const addedEl = container.lastElementChild;
            addedEl.classList.remove('translate-x-full', 'opacity-0');
            addedEl.classList.add('translate-x-0', 'opacity-100');
            
            setTimeout(() => {
              addedEl.classList.remove('translate-x-0', 'opacity-100');
              addedEl.classList.add('translate-x-full', 'opacity-0');
              setTimeout(() => addedEl.remove(), 300);
            }, 4000);
          });
        });
      }

      @if (successMsg != null)
      {
          <text>
            setTimeout(() => { showToast('success', @Html.Raw(Json.Serialize(successMsg))); }, 100);
          </text>
      }
      
      @if (errorMsg != null)
      {
          <text>
            setTimeout(() => { showToast('error', @Html.Raw(Json.Serialize(errorMsg))); }, 100);
          </text>
      }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>