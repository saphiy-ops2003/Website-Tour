@model WebsiteTour.Models.Entities.Tour
@{
    ViewData["Title"] = "Sửa Tour: " + Model?.Title;
    Layout = "_AdminLayout";
    var schedules = Model?.Schedules?.OrderBy(s => s.StartDate).ToList() ?? new List<WebsiteTour.Models.Entities.TourSchedule>();
}

<div class="max-w-3xl space-y-6">
    <!-- Edit Tour Form -->
    <form asp-action="EditTour" method="post">
        <input type="hidden" name="id" value="@Model!.Id" />
        <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-8">
            <h2 class="text-xl font-bold text-slate-800 mb-6">Thông tin Tour</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="md:col-span-2">
                    <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block mb-2">Tên Tour *</label>
                    <input name="Title" value="@Model.Title" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-accent outline-none font-medium text-slate-800" />
                </div>
                <div class="md:col-span-2">
                    <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block mb-2">Mô tả</label>
                    <textarea name="Description" rows="4" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-accent outline-none font-medium text-slate-800 resize-none">@Model.Description</textarea>
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block mb-2">Giá ($) *</label>
                    <input name="Price" type="number" step="0.01" value="@Model.Price" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-accent outline-none font-medium text-slate-800" />
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block mb-2">Thời gian *</label>
                    <input name="Duration" value="@Model.Duration" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-accent outline-none font-medium text-slate-800" />
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block mb-2">Danh mục *</label>
                    <select name="CategoryId" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-accent outline-none font-medium text-slate-800">
                        @foreach (var c in (List<WebsiteTour.Models.Entities.Category>)ViewBag.Categories)
                        {
                            <option value="@c.Id" selected="@(c.Id == Model.CategoryId)">@c.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block mb-2">Điểm đến *</label>
                    <select name="DestinationId" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-accent outline-none font-medium text-slate-800">
                        @foreach (var d in (List<WebsiteTour.Models.Entities.Destination>)ViewBag.Destinations)
                        {
                            <option value="@d.Id" selected="@(d.Id == Model.DestinationId)">@d.Name (@d.Region)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block mb-2">Badge</label>
                    <input name="Badge" value="@Model.Badge" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-accent outline-none font-medium text-slate-800" />
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block mb-2">Đánh giá (0–5)</label>
                    <input name="Rating" type="number" step="0.1" min="0" max="5" value="@Model.Rating" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-accent outline-none font-medium text-slate-800" />
                </div>
                <div class="md:col-span-2">
                    <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block mb-2">URL Hình ảnh</label>
                    <input name="imageUrl" type="url" value="@Model.Images?.FirstOrDefault()?.ImageUrl" placeholder="https://..." class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-accent outline-none font-medium text-slate-800" />
                </div>
            </div>
        </div>
        <div class="flex gap-4 mt-4">
            <button type="submit" class="bg-accent text-white px-8 py-3 rounded-xl font-bold shadow hover:opacity-90 transition-all">Lưu thay đổi</button>
            <a href="/Admin/Tours" class="bg-slate-100 text-slate-700 px-8 py-3 rounded-xl font-bold hover:bg-slate-200 transition-all">Hủy</a>
        </div>
    </form>

    <!-- Schedule Management -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-8">
        <h2 class="text-xl font-bold text-slate-800 mb-6">Lịch Khởi Hành</h2>
        @if (schedules.Any())
        {
            <div class="space-y-3 mb-6">
                @foreach (var s in schedules)
                {
                    <div class="flex items-center justify-between p-4 bg-slate-50 rounded-2xl border border-slate-200">
                        <div>
                            <p class="font-bold text-slate-800">@s.StartDate.ToString("dd/MM/yyyy")</p>
                            <p class="text-xs text-slate-500">Còn <span class="font-bold text-accent">@s.AvailableSeats</span> / @s.TotalSeats chỗ</p>
                        </div>
                        <form asp-action="DeleteSchedule" method="post" onsubmit="return confirm('Xóa lịch này?')">
                            <input type="hidden" name="id" value="@s.Id" />
                            <input type="hidden" name="tourId" value="@Model.Id" />
                            <button type="submit" class="w-9 h-9 bg-red-50 text-red-500 rounded-xl flex items-center justify-center hover:bg-red-100 transition-colors">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-slate-500 italic mb-6">Chưa có lịch khởi hành nào.</p>
        }

        <form asp-action="AddSchedule" method="post" class="flex flex-wrap items-end gap-4 bg-slate-50 p-4 rounded-2xl border border-dashed border-slate-300">
            <input type="hidden" name="tourId" value="@Model.Id" />
            <div class="flex-1 min-w-[160px]">
                <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block mb-2">Ngày khởi hành</label>
                <input name="startDate" type="date" min="@DateTime.Now.ToString("yyyy-MM-dd")" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-accent outline-none font-medium" />
            </div>
            <div class="min-w-[120px]">
                <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block mb-2">Số chỗ</label>
                <input name="totalSeats" type="number" min="1" value="20" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-accent outline-none font-medium" />
            </div>
            <button type="submit" class="bg-accent text-white px-6 py-3 rounded-xl font-bold hover:opacity-90 transition-all">+ Thêm lịch</button>
        </form>
    </div>
</div>
