@model IEnumerable<WebsiteTour.Models.Entities.Booking>
@{
    ViewData["Title"] = "Quản lý Đơn đặt Tour";
    Layout = "_AdminLayout";
}

<div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="p-6 border-b border-slate-100 flex justify-between items-center bg-slate-50">
        <h2 class="text-lg font-bold text-slate-800">Tất cả đơn đặt Tour</h2>
        <div class="flex gap-2">
            <input type="text" placeholder="Tìm kiếm mã ĐH..." class="px-4 py-2 border border-slate-200 rounded-xl outline-none focus:border-accent text-sm" />
            <button class="bg-primary text-white px-4 py-2 rounded-xl text-sm font-bold shadow hover:bg-primary-light transition-all">Tìm kiếm</button>
        </div>
    </div>
    <div class="overflow-x-auto p-4">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="text-slate-500 text-xs uppercase tracking-widest border-b border-slate-200">
                    <th class="p-4 font-bold">Mã ĐH</th>
                    <th class="p-4 font-bold">Khách Hàng</th>
                    <th class="p-4 font-bold">Tour & Lịch Trình</th>
                    <th class="p-4 font-bold">Khách</th>
                    <th class="p-4 font-bold">Tổng Tiền</th>
                    <th class="p-4 font-bold">Trạng Thái</th>
                    <th class="p-4 font-bold text-right">Thao tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var booking in Model)
                {
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="p-4 font-bold text-slate-800">#@booking.Id<br><span class="text-[10px] text-slate-400 font-normal">@booking.BookingDate.ToString("dd/MM/yyyy")</span></td>
                        <td class="p-4">
                            <p class="font-bold text-slate-800">@booking.User?.Username</p>
                            <p class="text-xs text-slate-500">@booking.User?.Email</p>
                        </td>
                        <td class="p-4">
                            <p class="font-semibold text-slate-700 line-clamp-1 max-w-[200px]" title="@booking.Tour?.Title">@booking.Tour?.Title</p>
                            <p class="text-xs text-accent font-bold mt-1">@booking.TourSchedule?.StartDate.ToString("dd/MM/yyyy")</p>
                        </td>
                        <td class="p-4">
                            <p class="text-sm font-bold text-slate-800">@(booking.AdultCount + booking.ChildCount) người</p>
                            <p class="text-xs text-slate-500">(@booking.AdultCount NL, @booking.ChildCount TE)</p>
                        </td>
                        <td class="p-4">
                            <p class="font-black text-emerald-600">$@booking.TotalPrice</p>
                            @if(booking.DiscountAmount > 0)
                            {
                                <p class="text-[10px] bg-emerald-100 text-emerald-700 px-1 py-0.5 rounded inline-block">Đã giảm $@booking.DiscountAmount</p>
                            }
                        </td>
                        <td class="p-4">
                            <form asp-action="UpdateBookingStatus" method="post" class="flex items-center gap-2">
                                <input type="hidden" name="id" value="@booking.Id" />
                                <select name="status" onchange="this.form.submit()" class="text-xs font-bold px-3 py-1.5 rounded-lg border border-slate-200 outline-none cursor-pointer
                                    @(booking.Status == "Confirmed" ? "bg-emerald-50 text-emerald-700 border-emerald-200" : 
                                      booking.Status == "Cancelled" ? "bg-red-50 text-red-700 border-red-200" : 
                                      "bg-amber-50 text-amber-700 border-amber-200")">
                                    <option value="Pending" selected="@(booking.Status == "Pending")">Chờ Xử Lý</option>
                                    <option value="Confirmed" selected="@(booking.Status == "Confirmed")">Đã Xác Nhận</option>
                                    <option value="Cancelled" selected="@(booking.Status == "Cancelled")">Đã Hủy</option>
                                </select>
                            </form>
                        </td>
                        <td class="p-4 text-right">
                            <button class="w-8 h-8 bg-slate-100 text-slate-600 rounded-lg flex items-center justify-center hover:bg-slate-200 hover:text-slate-800 transition-colors ml-auto" title="Chi tiết">
                                <i data-lucide="eye" class="w-4 h-4"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
