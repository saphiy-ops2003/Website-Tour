@model IEnumerable<WebsiteTour.Models.Entities.PromoCode>
@{
    ViewData["Title"] = "Quản lý Mã Giảm Giá";
    Layout = "_AdminLayout";
}

<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
  <div class="xl:col-span-1 bg-white rounded-3xl border border-slate-200 shadow-sm p-6 self-start sticky top-6">
    <h2 class="text-lg font-bold text-slate-800 mb-4">Tạo Mã Mới</h2>
    <form asp-action="CreatePromo" method="post" class="space-y-4">
      <div>
        <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block mb-1.5">Mã Code *</label>
        <input name="Code" required placeholder="VD: SUMMER2025" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-accent outline-none font-bold text-slate-800 uppercase" />
      </div>
      <div>
        <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block mb-1.5">Tiêu đề *</label>
        <input name="Title" required placeholder="Giảm 50$ mùa hè" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-accent outline-none font-medium text-slate-800" />
      </div>
      <div>
        <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block mb-1.5">Mô tả</label>
        <input name="Description" placeholder="Áp dụng cho đơn từ $200" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-accent outline-none font-medium text-slate-800" />
      </div>
      <div>
        <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block mb-1.5">Danh mục</label>
        <input name="Category" placeholder="Khách hàng mới, Mùa hè..." class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-accent outline-none font-medium text-slate-800" />
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block mb-1.5">Mức giảm ($) *</label>
          <input name="DiscountAmount" type="number" step="0.01" required placeholder="50" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-accent outline-none font-medium text-slate-800" />
        </div>
        <div>
          <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block mb-1.5">Đơn tối thiểu</label>
          <input name="MinOrderValue" type="number" step="0.01" value="0" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-accent outline-none font-medium text-slate-800" />
        </div>
      </div>
      <div>
        <label class="text-xs font-bold text-slate-500 uppercase tracking-widest block mb-1.5">Hết hạn *</label>
        <input name="ValidUntil" type="date" min="@DateTime.Now.ToString("yyyy-MM-dd")" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-accent outline-none font-medium text-slate-800" />
      </div>
      <button type="submit" class="w-full bg-accent text-white py-3 rounded-xl font-bold shadow hover:opacity-90 transition-all">
        Tạo mã giảm giá
      </button>
    </form>
  </div>

  <div class="xl:col-span-2 bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden flex flex-col h-[calc(100vh-140px)]">
    <div class="p-6 border-b border-slate-100 flex flex-col md:flex-row justify-between items-center gap-4">
      <h2 class="text-lg font-bold text-slate-800">Danh sách Mã Giảm Giá</h2>
      <div class="relative w-full md:w-72">
        <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
        <input type="text" id="searchInput" placeholder="Tìm mã, tiêu đề..." class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:border-accent outline-none" />
      </div>
    </div>
    
    <div class="flex-1 overflow-auto">
      <table class="w-full text-left border-collapse">
        <thead class="sticky top-0 bg-slate-50 z-10 shadow-sm">
          <tr class="text-slate-500 text-xs uppercase tracking-widest border-b border-slate-200">
            <th class="p-4 font-bold">Mã Code</th>
            <th class="p-4 font-bold">Giá trị</th>
            <th class="p-4 font-bold">Tình trạng</th>
            <th class="p-4 font-bold text-right">Thao tác</th>
          </tr>
        </thead>
        <tbody id="tableBody" class="divide-y divide-slate-100">
          @foreach (var promo in Model)
          {
            <tr class="promo-row hover:bg-slate-50 transition-colors @(promo.IsActive ? "" : "opacity-60")" data-code="@promo.Code.ToLower()" data-title="@promo.Title.ToLower()">
              <td class="p-4">
                 <p class="font-black text-slate-800 tracking-wider text-sm bg-slate-100 inline-block px-2 py-1 rounded">@promo.Code</p>
                 <p class="font-bold text-slate-700 text-xs mt-1">@promo.Title</p>
                 <p class="text-[10px] text-slate-500">@promo.Category</p>
              </td>
              <td class="p-4">
                 <p class="text-emerald-600 font-bold text-sm">-$@promo.DiscountAmount</p>
                 @if (promo.MinOrderValue > 0)
                 {
                    <p class="text-xs text-orange-500 font-semibold mt-1">Đơn từ $@promo.MinOrderValue</p>
                 }
              </td>
              <td class="p-4">
                 @if (promo.IsActive && promo.ValidUntil >= DateTime.Now)
                 {
                     <span class="inline-block bg-emerald-100 text-emerald-700 text-[10px] font-bold px-2 py-1 rounded">HOẠT ĐỘNG</span>
                 }
                 else
                 {
                     <span class="inline-block bg-red-100 text-red-600 text-[10px] font-bold px-2 py-1 rounded">ĐÃ TẮT/HẾT HẠN</span>
                 }
                 <p class="text-[10px] text-slate-400 mt-1 uppercase">Hạn: @promo.ValidUntil.ToString("dd/MM/yyyy")</p>
              </td>
              <td class="p-4 text-right">
                 <div class="flex items-center justify-end gap-2">
                   <form asp-action="TogglePromo" method="post" class="inline">
                     <input type="hidden" name="id" value="@promo.Id" />
                     <button type="submit" class="w-8 h-8 rounded-lg @(promo.IsActive ? "bg-amber-50 text-amber-500 hover:bg-amber-100" : "bg-emerald-50 text-emerald-600 hover:bg-emerald-100") flex items-center justify-center transition-colors" title="@(promo.IsActive ? "Tắt mã" : "Bật mã")">
                       <i data-lucide="@(promo.IsActive ? "pause" : "play")" class="w-4 h-4"></i>
                     </button>
                   </form>
                   <form asp-action="DeletePromo" method="post" onsubmit="return confirm('Xóa mã @promo.Code?')" class="inline">
                     <input type="hidden" name="id" value="@promo.Id" />
                     <button type="submit" class="w-8 h-8 rounded-lg bg-red-50 text-red-500 flex items-center justify-center hover:bg-red-100 transition-colors" title="Xóa">
                       <i data-lucide="trash-2" class="w-4 h-4"></i>
                     </button>
                   </form>
                 </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
      <div id="noResults" class="hidden p-8 text-center text-slate-500 font-medium">
        Không tìm thấy mã nào phù hợp.
      </div>
    </div>

    <div class="p-4 border-t border-slate-100 flex items-center justify-between text-sm bg-white">
      <p class="text-slate-500">Hiển thị <span id="pageInfo" class="font-bold text-slate-800"></span></p>
      <div class="flex items-center gap-1" id="paginationControls">
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const rows = Array.from(document.querySelectorAll('.promo-row'));
    const searchInput = document.getElementById('searchInput');
    const tableBody = document.getElementById('tableBody');
    const noResults = document.getElementById('noResults');
    const pageInfo = document.getElementById('pageInfo');
    const paginationControls = document.getElementById('paginationControls');
    
    let currentPage = 1;
    const itemsPerPage = 8; // Mức hiển thị cho promo
    let filteredRows = [...rows];

    function renderTable() {
      tableBody.innerHTML = '';
      if (filteredRows.length === 0) {
        noResults.classList.remove('hidden');
        pageInfo.textContent = '0/0';
        paginationControls.innerHTML = '';
        return;
      }
      noResults.classList.add('hidden');

      const totalPages = Math.ceil(filteredRows.length / itemsPerPage);
      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      const start = (currentPage - 1) * itemsPerPage;
      const end = start + itemsPerPage;
      const currentItems = filteredRows.slice(start, end);

      currentItems.forEach(row => tableBody.appendChild(row));
      
      pageInfo.textContent = `${start + 1}-${Math.min(end, filteredRows.length)} / ${filteredRows.length}`;
      renderPagination(totalPages);
      lucide.createIcons();
    }

    function renderPagination(totalPages) {
      paginationControls.innerHTML = '';
      if (totalPages <= 1) return;

      const createBtn = (text, page, disabled = false, active = false) => {
        const btn = document.createElement('button');
        btn.innerHTML = text;
        btn.disabled = disabled;
        btn.className = `w-8 h-8 rounded-lg flex items-center justify-center font-bold text-xs transition-colors ${
          active ? 'bg-accent text-white' : 
          disabled ? 'text-slate-300 cursor-not-allowed' : 
          'bg-slate-50 text-slate-600 hover:bg-slate-200'
        }`;
        if (!disabled && !active) {
          btn.onclick = () => { currentPage = page; renderTable(); };
        }
        return btn;
      };

      paginationControls.appendChild(createBtn('<i data-lucide="chevron-left" class="w-4 h-4"></i>', currentPage - 1, currentPage === 1));
      
      let startPage = Math.max(1, currentPage - 2);
      let endPage = Math.min(totalPages, startPage + 4);
      if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);

      for (let i = startPage; i <= endPage; i++) {
        paginationControls.appendChild(createBtn(i, i, false, i === currentPage));
      }

      paginationControls.appendChild(createBtn('<i data-lucide="chevron-right" class="w-4 h-4"></i>', currentPage + 1, currentPage === totalPages));
    }

    searchInput.addEventListener('input', (e) => {
      const term = e.target.value.toLowerCase();
      filteredRows = rows.filter(row => 
        row.getAttribute('data-code').includes(term) ||
        row.getAttribute('data-title').includes(term)
      );
      currentPage = 1;
      renderTable();
    });

    renderTable();
  });
</script>
}
