@model IEnumerable<WebsiteTour.Models.Entities.Tour>
@{
    ViewData["Title"] = "Quản lý Tour";
    Layout = "_AdminLayout";
}

<div class="flex justify-between items-center mb-6">
    <p class="text-slate-500 font-medium">Tổng cộng <span class="font-bold text-slate-800">@Model.Count()</span> tour</p>
    <a href="/Admin/CreateTour" class="bg-accent text-white px-5 py-2.5 rounded-xl font-bold shadow hover:opacity-90 transition-all flex items-center gap-2">
        <i data-lucide="plus" class="w-4 h-4"></i> Thêm Tour Mới
    </a>
</div>

<div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-widest border-b border-slate-200">
                    <th class="p-4 font-bold">Tour</th>
                    <th class="p-4 font-bold">Điểm đến</th>
                    <th class="p-4 font-bold">Giá</th>
                    <th class="p-4 font-bold">Lịch khởi hành</th>
                    <th class="p-4 font-bold">Đơn đặt</th>
                    <th class="p-4 font-bold text-right">Thao tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var tour in Model)
                {
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="p-4">
                            <div class="flex items-center gap-3">
                                @if (tour.Images?.Any() == true)
                                {
                                    <img src="@tour.Images.First().ImageUrl" class="w-12 h-12 rounded-xl object-cover shrink-0" />
                                }
                                else
                                {
                                    <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center shrink-0">
                                        <i data-lucide="image" class="w-5 h-5 text-slate-400"></i>
                                    </div>
                                }
                                <div>
                                    <p class="font-bold text-slate-800 line-clamp-1 max-w-[220px]">@tour.Title</p>
                                    <p class="text-xs text-slate-500">@tour.Duration</p>
                                </div>
                            </div>
                        </td>
                        <td class="p-4 text-sm font-semibold text-slate-700">@tour.Destination?.Name</td>
                        <td class="p-4 font-black text-accent">$@tour.Price</td>
                        <td class="p-4">
                            @{var upcoming = tour.Schedules?.Where(s => s.StartDate > DateTime.Now).Count() ?? 0;}
                            <span class="text-sm font-bold text-slate-800">@upcoming lịch</span>
                        </td>
                        <td class="p-4">
                            <span class="text-sm font-bold text-slate-800">@(tour.Bookings?.Count ?? 0)</span>
                        </td>
                        <td class="p-4">
                            <div class="flex items-center gap-2 justify-end">
                                <a href="/Admin/EditTour/@tour.Id" class="w-9 h-9 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center hover:bg-blue-100 transition-colors">
                                    <i data-lucide="pencil" class="w-4 h-4"></i>
                                </a>
                                <form asp-action="DeleteTour" method="post" onsubmit="return confirm('Bạn chắc muốn xóa tour này?')">
                                    <input type="hidden" name="id" value="@tour.Id" />
                                    <button type="submit" class="w-9 h-9 bg-red-50 text-red-500 rounded-xl flex items-center justify-center hover:bg-red-100 transition-colors">
                                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
