@model IEnumerable<WebsiteTour.Models.Entities.Booking>
@{
    ViewData["Title"] = "Tổng Quan";
    Layout = "_AdminLayout";
}

<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <!-- Stats Cards -->
    <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm flex items-center gap-6">
        <div class="w-14 h-14 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
            <i data-lucide="map" class="w-7 h-7"></i>
        </div>
        <div>
            <p class="text-slate-500 text-sm font-semibold mb-1">Tổng số Tour</p>
            <h3 class="text-3xl font-black text-slate-800">@ViewBag.TotalTours</h3>
        </div>
    </div>
    
    <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm flex items-center gap-6">
        <div class="w-14 h-14 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
            <i data-lucide="shopping-bag" class="w-7 h-7"></i>
        </div>
        <div>
            <p class="text-slate-500 text-sm font-semibold mb-1">Đơn đặt Tour</p>
            <h3 class="text-3xl font-black text-slate-800">@ViewBag.TotalBookings</h3>
        </div>
    </div>
    
    <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm flex items-center gap-6">
        <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
            <i data-lucide="dollar-sign" class="w-7 h-7"></i>
        </div>
        <div>
            <p class="text-slate-500 text-sm font-semibold mb-1">Doanh thu (Confirmed)</p>
            <h3 class="text-3xl font-black text-slate-800">$@ViewBag.TotalRevenue</h3>
        </div>
    </div>
    
    <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm flex items-center gap-6">
        <div class="w-14 h-14 rounded-2xl bg-orange-50 text-orange-600 flex items-center justify-center shrink-0">
            <i data-lucide="users" class="w-7 h-7"></i>
        </div>
        <div>
            <p class="text-slate-500 text-sm font-semibold mb-1">Khách hàng</p>
            <h3 class="text-3xl font-black text-slate-800">@ViewBag.TotalUsers</h3>
        </div>
    </div>
</div>

<!-- Recent Bookings Table -->
<div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="p-6 border-b border-slate-100 flex justify-between items-center">
        <h2 class="text-lg font-bold text-slate-800">Đơn đặt Tour gần đây</h2>
        <a href="/Admin/Bookings" class="text-sm font-semibold text-accent hover:underline">Xem tất cả</a>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-widest border-b border-slate-100">
                    <th class="p-4 font-bold">Mã ĐH</th>
                    <th class="p-4 font-bold">Khách Hàng</th>
                    <th class="p-4 font-bold">Tour</th>
                    <th class="p-4 font-bold">Tổng Tiền</th>
                    <th class="p-4 font-bold">Trạng Thái</th>
                    <th class="p-4 font-bold">Ngày Đặt</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var booking in Model)
                {
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="p-4 font-bold text-slate-800">#@booking.Id</td>
                        <td class="p-4">
                            <p class="font-bold text-slate-800">@booking.User?.Username</p>
                        </td>
                        <td class="p-4">
                            <p class="font-semibold text-slate-700 line-clamp-1 max-w-[200px]">@booking.Tour?.Title</p>
                        </td>
                        <td class="p-4 font-bold text-emerald-600">$@booking.TotalPrice</td>
                        <td class="p-4">
                            @if (booking.Status == "Confirmed")
                            {
                                <span class="bg-emerald-100 text-emerald-700 px-3 py-1 rounded-lg text-xs font-bold uppercase tracking-wider">Đã xác nhận</span>
                            }
                            else if (booking.Status == "Cancelled")
                            {
                                <span class="bg-red-100 text-red-700 px-3 py-1 rounded-lg text-xs font-bold uppercase tracking-wider">Đã Hủy</span>
                            }
                            else
                            {
                                <span class="bg-amber-100 text-amber-700 px-3 py-1 rounded-lg text-xs font-bold uppercase tracking-wider">Chờ Xử Lý</span>
                            }
                        </td>
                        <td class="p-4 text-sm text-slate-500 font-medium">@booking.BookingDate.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
