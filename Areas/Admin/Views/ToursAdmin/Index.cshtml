@model IEnumerable<WebsiteTour.Models.Entities.Tour>
@{
    ViewData["Title"] = "Quản lý Tour";
    Layout = "_AdminLayout";
}

<div class="flex flex-col md:flex-row justify-between items-center gap-4 mb-6">
    <div class="flex items-center gap-4">
        <p class="text-slate-500 font-medium">Tổng cộng <span class="font-bold text-slate-800">@Model.Count()</span> tour</p>
        <div class="relative w-full md:w-72">
            <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
            <input type="text" id="searchInput" placeholder="Tìm tên tour, điểm đến..." class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:border-accent outline-none bg-white shadow-sm" />
        </div>
    </div>
    <a href="/Admin/ToursAdmin/CreateTour" class="bg-accent text-white px-5 py-2.5 rounded-xl font-bold shadow hover:opacity-90 transition-all flex items-center gap-2">
        <i data-lucide="plus" class="w-4 h-4"></i> Thêm Tour Mới
    </a>
</div>


<div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-widest border-b border-slate-200">
                    <th class="p-4 font-bold">Tour</th>
                    <th class="p-4 font-bold">Điểm đến</th>
                    <th class="p-4 font-bold">Giá</th>
                    <th class="p-4 font-bold">Lịch khởi hành</th>
                    <th class="p-4 font-bold">Đơn đặt</th>
                    <th class="p-4 font-bold text-right">Thao tác</th>
                </tr>
            </thead>
            <tbody id="tableBody" class="divide-y divide-slate-100">
                @foreach (var tour in Model)
                {
                    string destinations = string.Join(", ", tour.TourDestinations.Select(td => td.Destination?.Name).Where(name => !string.IsNullOrWhiteSpace(name)));
                    <tr class="tour-row hover:bg-slate-50 transition-colors @(tour.IsDeleted ? "opacity-50 grayscale" : "")" data-title="@tour.Title.ToLower()" data-dest="@destinations.ToLower()">
                        <td class="p-4">
                            <div class="flex items-center gap-3">
                                @if (tour.Images?.Any() == true)
                                {
                                    <img src="@tour.Images.First().ImageUrl" class="w-12 h-12 rounded-xl object-cover shrink-0" />
                                }
                                else
                                {
                                    <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center shrink-0">
                                        <i data-lucide="image" class="w-5 h-5 text-slate-400"></i>
                                    </div>
                                }
                                <div>
                                    <p class="font-bold text-slate-800 line-clamp-1 max-w-[220px]">@tour.Title</p>
                                    <p class="text-xs text-slate-500">@tour.Duration</p>
                                    @if (tour.IsDeleted)
                                    {
                                        <span class="inline-block mt-1 bg-red-100 text-red-600 text-[10px] px-2 py-0.5 rounded-lg uppercase tracking-wider font-bold">Đã bị ẩn (Soft Delete)</span>
                                    }
                                </div>
                            </div>
                        </td>
                        <td class="p-4 text-sm font-semibold text-slate-700">
                            @destinations
                        </td>
                        <td class="p-4 font-black text-accent">$@tour.Price</td>
                        <td class="p-4">
                            @if (tour.Schedules != null && tour.Schedules.Any(s => s.StartDate > DateTime.Now))
                            {
                                var upcomingSchedules = tour.Schedules.Where(s => s.StartDate > DateTime.Now).OrderBy(s => s.StartDate).ToList();
                                <div class="flex flex-wrap gap-1 max-w-[200px]">
                                    @foreach (var s in upcomingSchedules.Take(3))
                                    {
                                        <span class="bg-blue-50 text-blue-600 text-[10px] px-2 py-1 rounded font-bold whitespace-nowrap">@s.StartDate.ToString("dd/MM")</span>
                                    }
                                    @if (upcomingSchedules.Count > 3)
                                    {
                                        <span class="bg-slate-100 text-slate-500 text-[10px] px-2 py-1 rounded font-bold">+@(upcomingSchedules.Count - 3)</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-xs text-slate-400 italic">Chưa có</span>
                            }
                        </td>
                        <td class="p-4">
                            <span class="text-sm font-bold text-slate-800">@(tour.Bookings?.Count ?? 0)</span>
                        </td>
                        <td class="p-4">
                            <div class="flex items-center gap-2 justify-end">
                                @if (!tour.IsDeleted)
                                {
                                    <a href="/Admin/ToursAdmin/EditTour/@tour.Id" class="w-9 h-9 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center hover:bg-blue-100 transition-colors">
                                        <i data-lucide="pencil" class="w-4 h-4"></i>
                                    </a>
                                    <form asp-action="DeleteTour" method="post" onsubmit="return confirm('Bạn chắc muốn xóa tour này?')">
                                        <input type="hidden" name="id" value="@tour.Id" />
                                        <button type="submit" class="w-9 h-9 bg-red-50 text-red-500 rounded-xl flex items-center justify-center hover:bg-red-100 transition-colors">
                                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-xs font-bold text-slate-400">Không thể thao tác</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div id="noResults" class="hidden p-8 text-center text-slate-500 font-medium">
            Không tìm thấy tour nào phù hợp.
        </div>
    </div>
    
    <div class="p-4 border-t border-slate-100 flex items-center justify-between text-sm bg-white">
        <p class="text-slate-500">Hiển thị <span id="pageInfo" class="font-bold text-slate-800"></span></p>
        <div class="flex items-center gap-1" id="paginationControls">
        </div>
    </div>
</div>

@section Scripts {
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const rows = Array.from(document.querySelectorAll('.tour-row'));
    const searchInput = document.getElementById('searchInput');
    const tableBody = document.getElementById('tableBody');
    const noResults = document.getElementById('noResults');
    const pageInfo = document.getElementById('pageInfo');
    const paginationControls = document.getElementById('paginationControls');
    
    let currentPage = 1;
    const itemsPerPage = 10;
    let filteredRows = [...rows];

    function renderTable() {
      tableBody.innerHTML = '';
      if (filteredRows.length === 0) {
        noResults.classList.remove('hidden');
        pageInfo.textContent = '0/0';
        paginationControls.innerHTML = '';
        return;
      }
      noResults.classList.add('hidden');

      const totalPages = Math.ceil(filteredRows.length / itemsPerPage);
      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      const start = (currentPage - 1) * itemsPerPage;
      const end = start + itemsPerPage;
      const currentItems = filteredRows.slice(start, end);

      currentItems.forEach(row => tableBody.appendChild(row));
      
      pageInfo.textContent = `${start + 1}-${Math.min(end, filteredRows.length)} / ${filteredRows.length}`;
      renderPagination(totalPages);
      lucide.createIcons();
    }

    function renderPagination(totalPages) {
      paginationControls.innerHTML = '';
      if (totalPages <= 1) return;

      const createBtn = (text, page, disabled = false, active = false) => {
        const btn = document.createElement('button');
        btn.innerHTML = text;
        btn.disabled = disabled;
        btn.className = `w-8 h-8 rounded-lg flex items-center justify-center font-bold text-xs transition-colors ${
          active ? 'bg-accent text-white' : 
          disabled ? 'text-slate-300 cursor-not-allowed' : 
          'bg-slate-50 text-slate-600 hover:bg-slate-200'
        }`;
        if (!disabled && !active) {
          btn.onclick = () => { currentPage = page; renderTable(); };
        }
        return btn;
      };

      paginationControls.appendChild(createBtn('<i data-lucide="chevron-left" class="w-4 h-4"></i>', currentPage - 1, currentPage === 1));
      
      let startPage = Math.max(1, currentPage - 2);
      let endPage = Math.min(totalPages, startPage + 4);
      if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);

      for (let i = startPage; i <= endPage; i++) {
        paginationControls.appendChild(createBtn(i, i, false, i === currentPage));
      }

      paginationControls.appendChild(createBtn('<i data-lucide="chevron-right" class="w-4 h-4"></i>', currentPage + 1, currentPage === totalPages));
    }

    searchInput.addEventListener('input', (e) => {
      const term = e.target.value.toLowerCase();
      filteredRows = rows.filter(row => 
        row.getAttribute('data-title').includes(term) || 
        row.getAttribute('data-dest').includes(term)
      );
      currentPage = 1;
      renderTable();
    });

    renderTable();
  });
</script>
}
